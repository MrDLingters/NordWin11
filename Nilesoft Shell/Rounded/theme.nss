theme
{
	name = "modern"

	view = view.small

	background
	{
		color = #2e3440
		opacity = 100
		// effect = 2
	}

	item
	{
		opacity = 100
		radius = 0
		prefix = 1

		text
		{
			normal = #d8dee9
			select = #d8dee9
			normal-disabled = #bdc2cd76
			select-disabled = #bdc2cd76
		}

		back
		{
			select = #4c566a
			select-disabled = #4c566a
		}
	}

	font
	{
		size = 18
	 	name = "JetBrainsMono NFP"
	 	weight = 1
	 	italic = 0
	 }

	border
	{
		enabled = true
		size = 2
		color = #434c5e
		opacity = 100
		radius = 16
	}

	shadow
	{
		enabled = true
		size = 5
		opacity = 5
		color = #11111b
	}

	separator
	{
		size = 1
		color = #4c566a
	}

	symbol
	{
		normal = #e5e7eb
		select = #e5e7eb
		normal-disabled = #e5e7eb7a
		select-disabled = #e5e7eb7a
	}

	image
	{
		enabled = false
		color = [#e5e7eb, #e5e7eb, #e5e7eb]
	}
}